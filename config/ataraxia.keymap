/*
 *
 * List of behvaiors here > https://github.com/zmkfirmware/zmk/tree/main/app/dts/behaviors
 *
 *
 * #undef ZMK_BEHAVIORS_KEEP_ALL
 * #define ZMK_BEHAVIORS_KEEP_BT
 * #define ZMK_BEHAVIORS_KEEP_KP
 * #define ZMK_BEHAVIORS_KEEP_LT
 * #define ZMK_BEHAVIORS_KEEP_MKP
 * #define ZMK_BEHAVIORS_KEEP_MMV
 * #define ZMK_BEHAVIORS_KEEP_MSC
 * #define ZMK_BEHAVIORS_KEEP_MT
 * #define ZMK_BEHAVIORS_KEEP_NONE
 * #define ZMK_BEHAVIORS_KEEP_SK
 *
 *
 */




#define ZMK_POINTING_DEFAULT_MOVE_VAL 500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <input/processors.dtsi>
// #include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
// #include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/input_transform.h>


#define ALPHA       0
#define SYMBOL      1
#define NUMBER      2
#define FUNCTION    3
#define MOUSE       4
#define SCROLL      5
#define AUTOMOUSE   6

/* Auto-activate a dedicated layer while the trackball is moving (ZSA Voyager
 * Navigator-style behavior), using driver-02's native automouse-layer
 * feature. Deliberately NOT layer 4 or 5 (MOUSE_layer's scroll-layers = <4
 * 5>, per the module's own nice_nano_v2.overlay) or layer 7 (snipe-layers)
 * -- using one of those would mean ball movement gets reinterpreted as
 * scroll/snipe instead of plain cursor movement the moment auto-activation
 * kicks in. CONFIG_PMW3610_AUTOMOUSE_TIMEOUT_MS is set very high so this
 * stays active instead of timing out; see AUTOMOUSE_layer's &to ALPHA for
 * the manual way back to the base layer. */
&trackball {
    automouse-layer = <AUTOMOUSE>;
    /* The shield's board fixup sets scroll-layers = <4 5>, but layer 4 is
     * MOUSE -- the very layer held via MSEA to get click-button access. That
     * made holding MSEA reinterpret ball movement as scrolling instead of
     * cursor movement ("locks the cursor"). Dropped 4 so MSEA no longer
     * forces scroll; SCROLL(5) is now reached independently via SCRH below. */
    scroll-layers = <SCROLL>;
};

/* zmk-pointing-acceleration-alpha, Level 2 (Standard) custom tuning -- see
 * CONFIG_INPUT_PROCESSOR_ACCEL_LEVEL_STANDARD/_PRESET_CUSTOM in ataraxia.conf.
 * This runs on every ball movement AND scroll event alike (it doesn't
 * distinguish them at runtime despite the per-axis "codes" property), so
 * these values shape both. All values below are a first-guess starting
 * point -- easy to retune, no other files involved:
 *   sensitivity          1000 = 1.0x baseline speed multiplier
 *   max-factor           multiplier applied once speed-max is reached
 *   min-factor           multiplier applied below speed-threshold (<1000 = slows down slow movements, 1000 = no effect)
 *   speed-threshold       counts/sec below which no acceleration is applied
 *   speed-max             counts/sec at which max-factor is fully reached
 *   acceleration-exponent  1=linear, 2=mild, 3=moderate, 4=strong, 5=aggressive curve between the thresholds
 *   y-boost               extra Y-axis multiplier on top of the above (1000 = none)
 *   sensor-dpi             should match CONFIG_PMW3610_CPI above (800) -- used to scale the counts/sec math correctly
 */
&pointer_accel {
    sensitivity = <1200>;
    max-factor = <2200>;
    min-factor = <1000>;
    speed-threshold = <500>;
    speed-max = <2500>;
    acceleration-exponent = <2>;
    y-boost = <1000>;
    sensor-dpi = <800>;
};

#define ESCFN  &lt FUNCTION ESC
#define NTAB   &lt NUMBER TAB
#define SYMZ   &lt SYMBOL Z
#define MSEA   &lt MOUSE A
/* Hold for scroll mode (trackball movement becomes scroll instead of cursor
 * movement), tap for GUI as before -- independent of MOUSE/MSEA. */
#define SCRH   &lt SCROLL RGUI

#define LSHF    &kp LSHFT
#define RSHF    &kp RSHFT
#define COMM    &kp COMMA
#define GRV     &kp GRAVE
#define UND     &kp UNDER

#define MM_U &mmv MOVE_UP
#define MM_D &mmv MOVE_DOWN
#define MM_R &mmv MOVE_RIGHT
#define MM_L &mmv MOVE_LEFT

#define MS_U &msc SCRL_UP
#define MS_D &msc SCRL_DOWN
#define MS_R &msc SCRL_RIGHT
#define MS_L &msc SCRL_LEFT

#define MCK  &mkp MCLK  
#define RCK  &mkp RCLK  
#define LCK  &mkp LCLK 

#define SPC_C   &spc_ctrl LCTRL SPACE
#define BSPC_W  &bspc_word 0 BSPC

&mmv_input_listener {
        standard {
            layers = <MOUSE>;
            input-processors = <&zip_xy_scaler 3 1>;
        };
};

&mmv {
    x-input-code = <INPUT_REL_X>;
    y-input-code = <INPUT_REL_Y>;
    time-to-max-speed-ms = <200>;
    acceleration-exponent = <1>;
};

&mt {
    tapping-term-ms = <160>;
};

&lt {
    tapping-term-ms = <150>;
};

/ {

    combos {

        compatible = "zmk,combos";
        combo_bootloader {
            timeout-ms = <100>;
            key-positions = <0 11>;
            bindings = <&bootloader>;
        };
    };

    macros {
        word_del: word_delete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp BSPC>
                , <&macro_release &kp LCTRL>
                ;
        };
    };

    behaviors {

        bkt: tap_dance_bracket {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LBKT>, <&kp RBKT>;
        };

        brc: tap_dance_brace {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LBRC>, <&kp RBRC>;
        };

        par: tap_dance_paren {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LPAR>, <&kp RPAR>;
        };

        thn: tap_dance_then {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LT>, <&kp GT>;
        };

        hrm: homerow_mods {
           compatible = "zmk,behavior-hold-tap";
           #binding-cells = <2>;
           tapping-term-ms = <250>;
           quick-tap-ms = <0>;
           flavor = "tap-preferred";
           bindings = <&kp>, <&kp>;

        };

        spc_ctrl: spacebar_hold_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        bspc_word: backspace_hold_word_delete {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&word_del>, <&kp>;
        };

    };



    keymap {
        compatible = "zmk,keymap";

        ALPHA_layer {
            display-name = "ATARAXIA";  
            bindings = <
                ESCFN   &kp Q   &kp W   &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I   &kp O   &kp P    BSPC_W
                NTAB    MSEA    &kp S   &kp D   &kp F   &kp G   &kp H   &kp J   &kp K   &kp L   &kp SEMI &kp QUOT
                LSHF    SYMZ    &kp X   &kp C   &kp V   &kp B   &kp N   &kp M   COMM    &kp DOT &kp FSLH &kp CAPS
                                &kp LCTRL &kp LALT SPC_C  &kp RET   SCRH &kp DEL
            >;
        };

        SYMBOL_layer {
            display-name = "SYMBOL";  
            bindings = <
                GRV &kp EXCL  &kp AT  &kp HASH  &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp STAR &kp PIPE &none &none
                GRV &kp TILDE UND     &kp EQUAL &none    &bkt  &brc  &par      &thn   &kp BSLH &none &none
                LSHF  &none &kp PLUS  &kp MINUS &none    &none &none &kp COLON &trans &kp SEMI RSHF &none
                                 &kp LCTRL &kp LALT SPC_C  &kp RET   &kp RGUI &kp DEL
            >;
        };

        NUMBER_layer {
            display-name = "NUMBER";  
            bindings = <
                &none &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &none
                &none &none  &none  &none  &none  &none  &none  &kp N4 &kp N5 &kp N6 &none  &none
                LSHF  &none  &none  &none  &none  &none  &none &kp N1 &kp N2 &kp N3 &none  RSHF 
                                 &kp LCTRL &kp LALT SPC_C  &kp RET   &kp RGUI &kp DEL
            >;
        };

        FUNCTION_layer {
            display-name = "FUNCTION";  
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &none &none &none &bt BT_CLR
                &none  &none  &none  &none  &none  &none  &none  &none  &none &none &none &none
                &bt BT_NXT  &bt BT_PRV  &none  &none  &none  &none  &none  &none  &none &none &studio_unlock &bootloader
                                 &kp LCTRL &kp LALT SPC_C  &kp RET   &kp RGUI &kp DEL
            >;
        };

        MOUSE_layer {
            display-name = "MOUSE";  
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  MS_U   MM_U   MS_D  &none &none
                &none  &none  &none  &none  &none  &none  &none  MM_L   MM_D   MM_R  &none &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none &none &none  
                                    MCK  RCK  LCK                        MCK  RCK  LCK
            >;
        };

        SCROLL_layer {
            display-name = "SCROLL";
            /* Fully transparent -- typing keys still work normally while
             * held. Layer 5's ID alone (via scroll-layers = <SCROLL> above)
             * is what makes the trackball driver treat ball movement as
             * scroll input while this layer is active; no bindings needed
             * here for that part. */
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                                    &trans &trans &trans          &trans &trans &trans
            >;
        };

        AUTOMOUSE_layer {
            display-name = "AUTOMOUSE";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                                    LCK    RCK    MCK          MCK    RCK    &to ALPHA
            >;
        };

        extra3 {
            status = "reserved";
        };

        extra4 {
            status = "reserved";
        };

    };
};
