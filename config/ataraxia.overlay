#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/*
 * Fix for the trackball's SPI0 MISO line: the shield module's own
 * boards/nice_nano_v2.overlay wires MOSI and MISO to the same pin
 * (P0.17), causing the PMW3610 to always read back product id 0xFF.
 * Both the broken line's own comment and pmw3610.dtsi's irq-gpios
 * comment independently point to P0.06 as the intended MISO pin, so
 * try that here without touching the pinned upstream module.
 */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                    <NRF_PSEL(SPIM_MISO, 0, 6)>;
            low-power-enable;
        };
    };
};
